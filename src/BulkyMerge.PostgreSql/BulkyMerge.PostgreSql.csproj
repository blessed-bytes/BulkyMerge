<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>BulkyMerge.PostgreSql</RootNamespace>
    <AssemblyName>BulkyMerge.PostgreSql</AssemblyName>
    <Description>High-performance bulk operations for PostgreSQL (Npgsql).</Description>
    <PackageId>BulkyMerge.PostgreSql</PackageId>
    <Title>BulkyMerge.PostgreSql</Title>
    <PackageTags>postgresql;npgsql;bulk;insert;upsert;dapper</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BulkyMerge.Core\BulkyMerge.Core.csproj" />
    <ProjectReference Include="..\BulkyMerge.Abstractions\BulkyMerge.Abstractions.csproj" />
    <ProjectReference Include="..\BulkyMerge.SourceGenerators\BulkyMerge.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
